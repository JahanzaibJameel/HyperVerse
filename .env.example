# ===================================================================
# HyperVerse Environment Variables Example
# ===================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file - it's already in .gitignore

# ===================================================================
# Expo Configuration
# ===================================================================
# Your app's domain for deployment
EXPO_PUBLIC_DOMAIN=your-domain.com

# Replit deployment ID (if using Replit)
EXPO_PUBLIC_REPL_ID=your-repl-id

# ===================================================================
# API Keys & External Services
# ===================================================================
# Sentry DSN for crash reporting
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# AI/ML Service Keys (if using external AI services)
EXPO_PUBLIC_OPENAI_API_KEY=your-openai-api-key
EXPO_PUBLIC_ANTHROPIC_API_KEY=your-anthropic-api-key

# Blockchain/Web3 Configuration
EXPO_PUBLIC_ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your-project-id
EXPO_PUBLIC_POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/your-project-id

# Analytics Services
EXPO_PUBLIC_ANALYTICS_API_KEY=your-analytics-api-key

# ===================================================================
# Development Configuration
# ===================================================================
# Development environment flag
NODE_ENV=development

# Enable debug logging
EXPO_PUBLIC_DEBUG_MODE=true

# Metro bundler configuration
EXPO_PUBLIC_METRO_PORT=8081

# ===================================================================
# Security Configuration
# ===================================================================
# SSL Certificate pinning (optional for offline-first app)
EXPO_PUBLIC_SSL_CERTIFICATE_SHA256=your-certificate-sha256-hash

# API timeout configuration
EXPO_PUBLIC_API_TIMEOUT_MS=30000

# ===================================================================
# Feature Flags
# ===================================================================
# Enable experimental features
EXPO_PUBLIC_ENABLE_EXPERIMENTAL_FEATURES=false

# Enable AI features
EXPO_PUBLIC_ENABLE_AI_FEATURES=true

# Enable blockchain features
EXPO_PUBLIC_ENABLE_BLOCKCHAIN_FEATURES=true

# Enable AR features
EXPO_PUBLIC_ENABLE_AR_FEATURES=true
